    "packages/llm-openai/package.json",
    "packages/llm-anthropic/dist",
    "packages/llm-anthropic/src",
    "packages/llm-anthropic/package.json",
    "packages/app-server/dist",
    "packages/app-server/src",
    "packages/app-server/package.json",
    "packages/plugin-authoring/dist",
    "packages/plugin-authoring/src",
    "packages/plugin-authoring/package.json",
    "packages/swarm-member/dist",
    "packages/swarm-member/src",
    "packages/swarm-member/package.json",
    "packages/cli/dist",
    "packages/cli/src",
    "packages/cli/package.json",
    "packages/bundle/src",
    "packages/bundle/package.json",
    "packages/bundle/cordis.patch.yml",
    "packages/bundle/cordis.dev.patch.yml",
    "packages/swarm/member.cordis.yml"
  ],
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.33.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
