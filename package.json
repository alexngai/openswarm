{
  "name": "openswarm",
  "version": "0.3.5",
  "description": "OpenSwarm multi-agent coding CLI: one agent is a tool, N coordinated agents are the product. Built on Anthropic's Claude Agent SDK with swarm/team orchestration, multi-provider support, and a Bun-native interactive TUI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "openswarm": "bin/openswarm.mjs",
    "swarm-harness": "bin/swarm-harness.mjs"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:compile": "bun scripts/build-binary.ts",
    "build:compile:darwin-arm64": "bun scripts/build-binary.ts bun-darwin-arm64",
    "build:compile:darwin-x64": "bun scripts/build-binary.ts bun-darwin-x64",
    "build:compile:linux-x64": "bun scripts/build-binary.ts bun-linux-x64",
    "prepublishOnly": "npm run build && npx --yes publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "test:ui": "bun test src/ui/repl-solid/",
    "test:ui:unit": "bun test src/ui/repl-solid/opentui.test.tsx src/ui/repl-solid/store.test.ts src/ui/repl-solid/transcript.test.tsx src/ui/repl-solid/input.test.tsx src/ui/repl-solid/status.test.tsx src/ui/repl-solid/dropdown.test.tsx src/ui/repl-solid/spinner.test.tsx src/ui/repl-solid/app.test.tsx src/ui/repl-solid/e2e.test.tsx",
    "test:ui:live": "bun test src/ui/repl-solid/cli-bun.test.ts",
    "test:all": "npm run test && npm run test:ui",
    "typecheck:ui": "tsc -p src/ui/repl-solid/tsconfig.json",
    "build:dev": "tsc",
    "build:packages": "npm run build:compile:darwin-arm64 && npm run build:compile:darwin-x64 && npm run build:compile:linux-x64",
    "publish:release": "bun scripts/publish.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "ai-agent",
    "multi-agent",
    "swarm",
    "coding-agent",
    "cli",
    "tui",
    "orchestration",
    "claude",
    "claude-agent-sdk",
    "anthropic",
    "openai",
    "codex",
    "acp"
  ],
  "author": "Alex Ngai <alexander.s.ngai@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/openswarm.git"
  },
  "bugs": {
    "url": "https://github.com/alexngai/openswarm/issues"
  },
  "homepage": "https://github.com/alexngai/openswarm#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "swarmkit-eval": "^0.0.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.24.0",
    "@ai-sdk/google": "3.0.64",
    "@ai-sdk/openai": "3.0.53",
    "@ai-sdk/xai": "3.0.83",
    "@anthropic-ai/claude-agent-sdk": "~0.2.116",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@multi-agent-protocol/sdk": "^0.1.15",
    "@opentui/core": "^0.1.99",
    "@opentui/solid": "^0.1.99",
    "@vscode/ripgrep": "^1.17.1",
    "agent-inbox": "^0.2.0",
    "ai": "6.0.168",
    "fast-glob": "^3.3.3",
    "git-cascade": "^0.0.7",
    "minimem": "^0.1.3",
    "proper-lockfile": "4.1.2",
    "sessionlog": "^0.0.8",
    "skill-tree": "^0.3.0",
    "solid-js": "^1.9.11",
    "turndown": "^7.2.4",
    "ws": "^8.21.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@swarmkit-ai/openswarm-cli-darwin-arm64": "0.3.5",
    "@swarmkit-ai/openswarm-cli-darwin-x64": "0.3.5",
    "@swarmkit-ai/openswarm-cli-linux-x64": "0.3.5"
  }
}
