{
  "name": "openswarm",
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/swarm --noEmit && tsc -p packages/git --noEmit && tsc -p packages/llm-openai --noEmit && tsc -p packages/swarm-member --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/llm-anthropic --noEmit && tsc -p packages/app-server --noEmit && tsc -p packages/plugin-authoring --noEmit && tsc -p packages/bundle --noEmit",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "build": "node scripts/build-packages.mjs",
    "presubmit": "npm run build && npm run typecheck && npm test",
    "prepack": "npm run build",
    "publish:npm": "npm run presubmit && npm publish",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "devDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-mock-server": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-dsh-sdk": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-terminal": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-terminal-bash": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-bash-persistent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-str-replace-editor": "^0.1.1-rc.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "openswarm": "bin/openswarm.mjs"
  },
  "description": "Run a swarm of coding agents on DeepSeek Harness \u2014 peer teams, worktree isolation, heterogeneous models.",
  "license": "MIT",
  "files": [
    "bin/openswarm.mjs",
    "scripts/init-profile.mjs",
    "LICENSE",
    "README.md",
    "packages/git/dist",
    "packages/git/src",
    "packages/git/package.json",
    "packages/swarm/dist",
    "packages/swarm/src",
    "packages/swarm/package.json",
    "packages/llm-openai/dist",
