{
  "name": "swarm-coder",
  "version": "0.0.1",
  "description": "swarm-compatible coding agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "swarm-coder": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "swarm",
    "agents",
    "claude",
    "coding"
  ],
  "author": "Alex Ngai <alexander.s.ngai@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/swarm-coder.git"
  },
  "bugs": {
    "url": "https://github.com/alexngai/swarm-coder/issues"
  },
  "homepage": "https://github.com/alexngai/swarm-coder",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.2.116",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.17.1",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-markdown": "^1.0.4",
    "turndown": "^7.2.4",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  }
}
