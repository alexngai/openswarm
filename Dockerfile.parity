# Dockerfile.parity — pinned toolchain for the product-parity verification
# harness (docs/63 §Verification strategy).
#
# This image deliberately contains no application source. The repository is
# bind-mounted at run time by compose.parity.yml, so editing code never
# invalidates the image layers and every work package is verified against the
# working tree rather than a stale copy.
#
# Versions are pinned to the exact toolchain CI resolves, so a green parity run
# and a green CI run mean the same thing. Bump both together.

# Pinned to the exact Node that setup-node resolves for `node-version: "22"`,
# because the bundled npm matters: the lockfile declares three @openswarm/cli-*
# optionalDependencies with no corresponding package entries, which npm 10.9.4
# rejects as out-of-sync and npm 10.9.8 accepts. Pinning the minor alone would
# make `npm ci` pass or fail depending on when the image happened to be built.
FROM node:22.23.1-bookworm

# Bun feeds `build:compile` and the OpenTUI/Solid suites, which cannot run
# under Node (@opentui/core depends on bun:ffi).
ARG BUN_VERSION=1.3.8

# node-pty and @vscode/ripgrep compile native addons during `npm ci`; the PTY
# e2e suite additionally needs a real TTY-capable environment. git is required
# by the workspace/landing fixtures, which exercise real refs and worktrees.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      python3 \
      git \
      ca-certificates \
      curl \
      unzip \
      jq \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
  && ln -s /root/.bun/bin/bun /usr/local/bin/bun
ENV BUN_INSTALL=/root/.bun
ENV PATH=/root/.bun/bin:$PATH

# The parity fixtures create commits, branches, and worktrees; git refuses to
# operate without an identity, and the bind-mounted tree is owned by the host
# user rather than root.
RUN git config --global user.email "parity@openswarm.local" \
  && git config --global user.name "OpenSwarm Parity Harness" \
  && git config --global --add safe.directory /workspace \
  && git config --global --add safe.directory '*'

WORKDIR /workspace

CMD ["bash"]
